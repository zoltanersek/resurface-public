---
// Tripwire documentation. An Astro route so /tripwire/docs/ resolves in dev, preview, and
// production alike. Shares the OutpostLabs site chrome and palette (navy header, amber
// accents) with the Resurface and SLAdar docs for a consistent look.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tripwire — Docs | Dependency Slip Alerts for Jira Cloud</title>
    <meta
      name="description"
      content="Documentation for Tripwire: get alerted when a Jira issue your team depends on slips — due date pushed, sprint punted, or gone stale. Every notification type, recipients, anti-spam, the weekly digest, the dashboard, and settings — all inside Atlassian."
    />
    <meta name="theme-color" content="#0E1726" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      :root {
        --navy: #0e1726;
        --navy2: #132038;
        --ink: #101b2e;
        --slate: #5a6b85;
        --paper: #f7f9fc;
        --line: #e7ecf3;
        --amber1: #ffc24b;
        --amber2: #ff7a2f;
        --amber: #ff7a2f;
        --white: #ffffff;
        --muted: #a9b8ce;
        --radius: 12px;
        --maxw: 880px;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        color: var(--ink);
        background: var(--white);
        font: 16px/1.65 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica,
          Arial, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--amber2); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }

      /* site header */
      header.site { background: var(--navy); position: sticky; top: 0; z-index: 20; border-bottom: 1px solid #1c2942; }
      header.site .nav { display: flex; align-items: center; justify-content: space-between; height: 66px; }
      header.site .brand { display: flex; align-items: center; gap: 12px; color: #fff; text-decoration: none; font-weight: 800; font-size: 19px; }
      header.site .brand:hover { text-decoration: none; }
      header.site .brand .logo { width: 38px; height: 38px; flex: none; }
      header.site .brand small { display: block; font-weight: 500; font-size: 11px; color: #8da0bc; letter-spacing: 0.2px; margin-top: -2px; }
      header.site .nav-right { display: flex; align-items: center; gap: 20px; }
      header.site .nav-right .navlink { color: #c8d5e6; text-decoration: none; font-weight: 600; font-size: 14px; }
      header.site .nav-right .navlink:hover { color: #fff; }
      .btn { display: inline-block; font-weight: 700; text-decoration: none; border-radius: 12px; padding: 10px 18px; font-size: 14px; transition: transform 0.06s ease, box-shadow 0.2s ease; }
      .btn:hover { text-decoration: none; }
      .btn:active { transform: translateY(1px); }
      .btn-primary { background: linear-gradient(135deg, var(--amber1), var(--amber2)); color: #2a1400; box-shadow: 0 8px 22px rgba(255, 122, 47, 0.28); }

      /* hero */
      header.hero { background: radial-gradient(1100px 500px at 80% -10%, #1b2c4b 0%, var(--navy) 55%); color: #fff; padding: 56px 0 48px; }
      header.hero .brand { display: flex; align-items: center; gap: 14px; }
      header.hero .brand .logo { width: 48px; height: 48px; flex: none; }
      header.hero .brand h1 { margin: 0; font-size: 26px; letter-spacing: -0.01em; }
      header.hero p.tag { margin: 18px 0 0; font-size: 19px; max-width: 640px; color: var(--muted); }
      header.hero .badges { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 8px; }
      .badge { display: inline-flex; align-items: center; gap: 8px; background: #16233a; border: 1px solid #2a3a57; color: #d7e1ef; padding: 6px 13px; border-radius: 999px; font-size: 13px; font-weight: 600; }

      /* toc */
      nav.toc { position: sticky; top: 66px; z-index: 10; background: rgba(255, 255, 255, 0.92); backdrop-filter: saturate(180%) blur(8px); border-bottom: 1px solid var(--line); }
      nav.toc .wrap { display: flex; flex-wrap: wrap; gap: 4px 18px; padding-top: 12px; padding-bottom: 12px; }
      nav.toc a { color: var(--slate); font-size: 14px; font-weight: 600; }
      nav.toc a:hover { color: var(--amber); text-decoration: none; }

      /* sections */
      main { padding: 8px 0 40px; }
      section { padding: 34px 0 8px; border-bottom: 1px solid var(--line); }
      section:last-of-type { border-bottom: 0; }
      h2 { font-size: 22px; margin: 0 0 6px; letter-spacing: -0.01em; scroll-margin-top: 130px; }
      h3 { font-size: 16px; margin: 22px 0 4px; }
      p, ul, ol { color: #344563; }
      ul.clean { list-style: none; padding-left: 0; }
      ul.clean li { padding-left: 26px; position: relative; margin: 8px 0; }
      ul.clean li::before { content: '✓'; position: absolute; left: 0; top: 0; color: var(--amber2); font-weight: 700; }
      code { background: var(--paper); border: 1px solid var(--line); border-radius: 5px; padding: 1px 6px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.9em; color: var(--amber2); }
      .lead { font-size: 18px; color: var(--slate); }
      .note { background: var(--paper); border: 1px solid var(--line); border-left: 4px solid var(--amber); border-radius: var(--radius); padding: 14px 16px; margin: 18px 0; }
      .note strong { color: var(--ink); }

      table { width: 100%; border-collapse: collapse; margin: 14px 0; font-size: 15px; }
      th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { color: var(--slate); font-size: 13px; text-transform: uppercase; letter-spacing: 0.04em; }

      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin: 16px 0; }
      .card { border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; background: #fff; }
      .card h3 { margin-top: 0; }

      /* alert sample */
      .alert { border: 1px solid var(--line); border-left: 4px solid var(--amber); border-radius: var(--radius); background: #fff; padding: 14px 16px; margin: 12px 0; }
      .alert .msg { font-size: 14.5px; color: #384356; margin: 0; line-height: 1.55; }
      .alert .msg strong { color: var(--ink); }
      .alert .who { display: block; margin-top: 8px; font-size: 12.5px; color: var(--slate); }
      .mention { color: #1868db; font-weight: 600; background: #e9f0fd; border-radius: 4px; padding: 0 4px; }
      .pill { display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.5px; border-radius: 999px; padding: 2px 9px; vertical-align: 1px; }
      .p-slip { background: #fdeaea; color: #c02626; }
      .p-punt { background: #fdf0e0; color: #b6600a; }
      .p-stale { background: #eef1f6; color: #55637a; }
      .p-clear { background: #e7f6ec; color: #1a7f42; }

      details { border: 1px solid var(--line); border-radius: var(--radius); padding: 4px 16px; margin: 10px 0; background: #fff; }
      details summary { cursor: pointer; font-weight: 600; padding: 10px 0; color: var(--ink); }
      details[open] summary { color: var(--amber); }
      details p { margin-top: 0; }

      footer.site { background: var(--navy); color: #9fb0c8; padding: 44px 0; font-size: 14px; }
      footer.site .foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
      footer.site .foot a { color: #c8d5e6; text-decoration: none; margin-left: 20px; }
      footer.site .foot .links a:first-child { margin-left: 0; }
      footer.site .foot a:hover { color: #fff; }

      @media (max-width: 560px) {
        header.site .nav-right .navlink { display: none; }
        footer.site .foot a { margin-left: 0; margin-right: 18px; }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap nav">
        <a class="brand" href="/tripwire/" aria-label="Tripwire home">
          <img class="logo" src="/tripwire/tripwire-logo.svg" alt="" aria-hidden="true" />
