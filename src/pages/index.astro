---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  wide
  title="OutpostLabs — small, focused apps that do one thing well"
  description="OutpostLabs is an independent software studio building small, focused apps that solve one real problem well. Home of Resurface (retro action item tracker for Jira), SLAdar (code review SLAs & stale pull request reminders for Bitbucket Cloud), and Berth (isolated dev environments for parallel AI coding agents)."
>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">OutpostLabs</p>
      <h1>Small, focused apps<br /><span class="amber">that do one thing well.</span></h1>
      <p class="lede">
        We're an independent software studio. We build lightweight tools that solve a single real
        problem — no bloat, no busywork, no lock-in.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/resurface/">Explore Resurface</a>
        <a class="btn btn-ghost" href="/blog">Read the blog</a>
      </div>
    </div>
  </section>

  <!-- PRODUCTS -->
  <section class="products">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow eyebrow-dark">What we're building</p>
        <h2>One problem at a time</h2>
      </div>
      <div class="grid">
        <a class="card" href="/resurface/">
          <span class="card-logo">
            <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="32" height="32" rx="8" fill="#0E1726" />
              <g stroke="#fff" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <g stroke-width="2.3">
                  <path d="M6 20 L11.5 20" />
                  <path d="M20.5 20 L26 20" />
                  <path d="M11.5 20 L9.8 17.8" />
                  <path d="M20.5 20 L22.2 17.8" />
                </g>
                <g stroke-width="2.7">
                  <path d="M16 25 L16 9.5" />
                  <path d="M11.6 14 L16 9.5 L20.4 14" />
                </g>
              </g>
            </svg>
          </span>
          <h3>Resurface</h3>
          <p>
            Retro &amp; sprint action items become owned, due-dated Jira issues that resurface until
            they're actually done.
          </p>
          <span class="card-link">Learn more →</span>
        </a>

        <a class="card" href="/sladar/">
          <span class="card-logo">
            <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="32" height="32" rx="8" fill="#0E1726" />
              <g stroke="#fff" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="16" cy="16" r="9.5" stroke-width="2.2" />
                <circle cx="16" cy="16" r="4.8" stroke-width="2.2" />
                <path d="M16 16 L23.4 8.6" stroke-width="2.5" />
              </g>
              <circle cx="21" cy="11" r="2" fill="#FF9A4A" />
            </svg>
          </span>
          <h3>SLAdar <span class="soon-tag">Coming soon</span></h3>
          <p>
            Put an SLA on code review in Bitbucket Cloud. SLAdar flags stale pull requests,
            nudges the reviewer on the PR, and reports your SLA-compliance rate — all inside
            Atlassian.
          </p>
          <span class="card-link">Learn more →</span>
        </a>

        <a class="card" href="/berth/">
          <span class="card-logo">
            <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="32" height="32" rx="8" fill="#0E1726" />
              <g stroke="#fff" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2">
                <path d="M6 22 L26 22" />
                <path d="M9 22 L9 13 L16 13 L16 22" />
                <path d="M16 22 L16 16 L23 16 L23 22" />
                <path d="M12 10 L12 13 M20 13 L20 16" />
              </g>
            </svg>
          </span>
          <h3>Berth</h3>
          <p>
            Give every AI coding agent its own isolated dev environment — its own worktree,
            auto-assigned ports, and isolated state. Free &amp; open source.
          </p>
          <span class="card-link">Learn more →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact">
    <div class="wrap">
      <p class="eyebrow eyebrow-dark">Get in touch</p>
      <h2>Say hello</h2>
      <p class="contact-line">
        Questions, ideas, or feedback? Email
        <a href="mailto:support@outpostlabs.dev">support@outpostlabs.dev</a>.
      </p>
    </div>
  </section>

  <style>
    .wrap {
      max-width: 1080px;
      margin: 0 auto;
      padding: 0 24px;
    }
    .eyebrow {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      color: var(--amber);
      margin: 0 0 14px;
    }

    /* hero */
    .hero {
      background: radial-gradient(1100px 500px at 80% -10%, #1b2c4b 0%, var(--navy) 55%);
      color: #fff;
      padding: 96px 0 104px;
    }
    .hero h1 {
      font-size: 54px;
      line-height: 1.06;
      letter-spacing: -1.6px;
      font-weight: 800;
      margin: 0 0 20px;
      max-width: 720px;
    }
    .hero h1 .amber {
      background: linear-gradient(135deg, var(--amber1), var(--amber2));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .lede {
      font-size: 20px;
      color: var(--muted);
      max-width: 580px;
      margin: 0 0 32px;
    }
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }
    .btn {
      display: inline-block;
      font-weight: 700;
      text-decoration: none;
      border-radius: 12px;
      padding: 14px 24px;
      font-size: 15px;
      transition: transform 0.06s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .btn:hover {
      text-decoration: none;
    }
    .btn:active {
      transform: translateY(1px);
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--amber1), var(--amber2));
      color: #2a1400;
      box-shadow: 0 8px 22px rgba(255, 122, 47, 0.28);
    }
    .btn-ghost {
      border: 1.5px solid rgba(255, 255, 255, 0.28);
      color: #fff;
    }
    .btn-ghost:hover {
      border-color: rgba(255, 255, 255, 0.6);
    }

    /* products */
    .products {
      padding: 84px 0;
    }
    .section-head {
      text-align: center;
      margin: 0 auto 42px;
    }
    .eyebrow-dark {
      color: var(--amber2);
    }
    .section-head h2 {
      font-size: 32px;
      letter-spacing: -0.6px;
      margin: 0;
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 22px;
      max-width: 860px;
      margin: 0 auto;
    }
    .card {
      display: block;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 30px;
      background: #fff;
      color: var(--ink);
      text-decoration: none;
      transition: transform 0.12s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }
    a.card:hover {
      text-decoration: none;
      transform: translateY(-3px);
      box-shadow: 0 18px 44px rgba(16, 27, 46, 0.12);
      border-color: #d4dce8;
    }
    .card-logo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      margin-bottom: 18px;
    }
    .card-logo svg {
      width: 48px;
      height: 48px;
    }
    .card-logo.dim {
      font-size: 28px;
      color: var(--amber);
      background: var(--paper);
      border-radius: 12px;
    }
    .card h3 {
      font-size: 21px;
      margin: 0 0 10px;
    }
    .soon-tag {
      display: inline-block;
      vertical-align: middle;
      margin-left: 8px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: var(--amber2);
      background: rgba(255, 122, 47, 0.12);
      border: 1px solid rgba(255, 122, 47, 0.28);
      border-radius: 999px;
      padding: 3px 9px;
    }
    .card p {
      color: var(--slate);
      margin: 0 0 18px;
      font-size: 15.5px;
      line-height: 1.6;
    }
    .card-link {
      font-weight: 700;
      font-size: 14.5px;
      color: var(--amber2);
    }
    .card.soon {
      background: var(--paper);
      border-style: dashed;
    }

    /* contact */
    .contact {
      background: var(--paper);
      border-top: 1px solid var(--line);
      padding: 72px 0;
      text-align: center;
    }
    .contact h2 {
      font-size: 30px;
      letter-spacing: -0.5px;
      margin: 0 0 12px;
    }
    .contact-line {
      color: var(--slate);
      margin: 0;
      font-size: 17px;
    }

    @media (max-width: 720px) {
      .hero {
        padding: 68px 0 76px;
      }
      .hero h1 {
        font-size: 38px;
      }
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
