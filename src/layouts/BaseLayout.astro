---
export interface Props {
  title: string;
  description?: string;
  /** Path or absolute URL for the canonical link + og:url. Defaults to the current page. */
  canonical?: string;
  /** Absolute URL to a social share image. */
  ogImage?: string;
  /** Set false to hide the site chrome (header/footer) — used by the full-bleed landing page. */
  chrome?: boolean;
  /** Set true to skip the 760px content column so the page can manage its own full-bleed sections. */
  wide?: boolean;
  /** Open Graph type. Use "article" for blog posts. */
  ogType?: string;
  /** ISO timestamp for article:published_time (blog posts). */
  publishedTime?: string;
  /** ISO timestamp for article:modified_time (blog posts). */
  modifiedTime?: string;
}

const {
  title,
  description = 'OutpostLabs — an independent studio building small, focused apps that do one thing well.',
  canonical,
  ogImage,
  chrome = true,
  wide = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#0E1726" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="OutpostLabs" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body>
    {
      chrome && (
        <header class="site-header">
          <nav class="site-nav">
            <a class="brand" href="/" aria-label="OutpostLabs home">
              <svg class="brand-logo" viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                  <linearGradient id="olSparkHeader" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" stop-color="#FFC24B" />
                    <stop offset="1" stop-color="#FF7A2F" />
                  </linearGradient>
                </defs>
                <circle cx="64" cy="64" r="42" fill="none" stroke="#E8EEF5" stroke-width="6.5" />
                <path d="M44 80 L64 52 L84 80" fill="none" stroke="#E8EEF5" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="64" cy="45" r="13" fill="#FFB020" opacity="0.22" />
                <path d="M64 35 L66 43 L73.5 45 L66 47 L64 55 L62 47 L54.5 45 L62 43 Z" fill="url(#olSparkHeader)" />
              </svg>
              <span>OutpostLabs</span>
            </a>
            <div class="nav-links">
              <a href="/resurface/">Resurface</a>
              <a href="/blog">Blog</a>
              <a href="mailto:support@outpostlabs.dev">Contact</a>
            </div>
          </nav>
        </header>
      )
    }

    <main class={chrome && !wide ? 'site-main' : undefined}>
      <slot />
    </main>

    {
      chrome && (
        <footer class="site-footer">
          <div class="footer-inner">
            <div>© {year} OutpostLabs.dev — small, focused apps that do one thing well.</div>
            <div class="footer-links">
              <a href="/resurface/">Resurface</a>
              <a href="/blog">Blog</a>
            </div>
          </div>
        </footer>
      )
    }

    <style is:global>
      :root {
        --navy: #0e1726;
        --navy2: #132038;
        --ink: #101b2e;
        --slate: #5a6b85;
        --paper: #f7f9fc;
        --line: #e7ecf3;
        --amber1: #ffc24b;
        --amber2: #ff7a2f;
        --amber: #ff7a2f;
        --white: #ffffff;
        --muted: #a9b8ce;
        --maxw: 760px;
      }
      * {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: var(--ink);
        background: var(--white);
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: var(--amber2);
        text-decoration: none;
      }
      a:hover {
        text-decoration: underline;
      }

      /* header */
      .site-header {
        background: var(--navy);
        border-bottom: 1px solid #1c2942;
      }
      .site-nav {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 24px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 11px;
        color: #fff;
        font-weight: 800;
        font-size: 18px;
      }
      .brand:hover {
        text-decoration: none;
      }
      .brand-logo {
        width: 32px;
        height: 32px;
        flex: none;
      }
      .nav-links {
        display: flex;
        gap: 22px;
        font-size: 15px;
        font-weight: 600;
      }
      .nav-links a {
        color: #c8d5e6;
      }
      .nav-links a:hover {
        color: #fff;
        text-decoration: none;
      }

      /* main */
      main {
        flex: 1 0 auto;
      }
      .site-main {
        max-width: var(--maxw);
        margin: 0 auto;
        padding: 56px 24px 72px;
      }

      /* footer */
      .site-footer {
        background: var(--navy);
        color: #9fb0c8;
        padding: 40px 0;
        font-size: 14px;
      }
      .footer-inner {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
      }
      .footer-links a {
        color: #c8d5e6;
        margin-left: 18px;
      }
      .footer-links a:first-child {
        margin-left: 0;
      }
      .footer-links a:hover {
        color: #fff;
      }

      @media (max-width: 560px) {
        .nav-links {
          gap: 16px;
        }
        .footer-inner {
          flex-direction: column;
          align-items: flex-start;
        }
        .footer-links a {
          margin-left: 0;
          margin-right: 18px;
        }
      }
    </style>
  </body>
</html>
